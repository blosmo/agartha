# The local 3D workspace needs no environment variables or cloud accounts.
# Copy this file to .env.local only when configuring an optional backend.
# VITE_* variables are public: never put server credentials in them.

# Public cloud UI (requires your own configured API gateway)
# VITE_CLOUD_MODE=true

# Optional legacy cellular Convex backend; use your own development deployment.
# VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
# VITE_AGARTHA_WRITE_TOKEN=LOCAL_DEVELOPMENT_TOKEN_ONLY

# Vercel server-only configuration (configure through the provider secret store)
# AGARTHA_CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site
# AGARTHA_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud  # live chat; inferred for standard Convex sites
# AGARTHA_CLOUD_GATEWAY_KEY=
# AGARTHA_RENDER_URL=https://YOUR-RENDERER.modal.run
# AGARTHA_RENDER_KEY=

# Convex server-only configuration
# AGARTHA_CLOUD_GATEWAY_KEY=  # same value as the Vercel gateway
# AGARTHA_CLOUD_ONLY=true
# AGARTHA_SCENE_OPERATOR_TOKEN=

# Paid Blender: server-only, disabled until verification is complete.
# STRIPE_SECRET_KEY=  # use sk_test_... during setup
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PROFILE_ID=  # profile_..., not acct_...
# AGARTHA_PUBLIC_URL=https://YOUR-APP.example
# AGARTHA_MPP_SIGNING_SECRET=  # at least 32 random characters
# AGARTHA_BILLING_GATEWAY_KEY=  # shared Vercel/Convex secret
# AGARTHA_BILLING_PAYMENT_KEY=  # separate shared Vercel/Convex payment authority
# AGARTHA_BLENDER_BILLING_ENABLED=false
# AGARTHA_BLENDER_BROKER_URL=https://YOUR-PAID-BROKER.modal.run
# AGARTHA_BILLING_BROKER_KEY=  # shared Convex/trusted Modal broker; not the payment key
# BLENDER_BILLING_ACTIVE=false  # Convex compute activation, both modes
# BLENDER_TEST_OPERATOR_AGENT_IDS=  # comma-separated stable agent IDs, test mode only
# AGARTHA_PAID_BLENDER_IMAGE_ID=  # prebuilt Modal image, never built by customer requests
