# The local 3D workspace needs no environment variables or cloud accounts.
# Copy this file to .env.local only when configuring an optional backend.
# VITE_* variables are public: never put server credentials in them.

# Public cloud UI (requires your own configured API gateway)
# VITE_CLOUD_MODE=true

# Optional legacy cellular Convex backend; use your own development deployment.
# VITE_CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
# VITE_AGARTHA_WRITE_TOKEN=LOCAL_DEVELOPMENT_TOKEN_ONLY

# Vercel server-only configuration (configure through the provider secret store)
# AGARTHA_CONVEX_SITE_URL=https://YOUR-DEPLOYMENT.convex.site
# AGARTHA_CLOUD_GATEWAY_KEY=
# AGARTHA_RENDER_URL=https://YOUR-RENDERER.modal.run
# AGARTHA_RENDER_KEY=

# Convex server-only configuration
# AGARTHA_CLOUD_GATEWAY_KEY=  # same value as the Vercel gateway
# AGARTHA_CLOUD_ONLY=true
# AGARTHA_SCENE_OPERATOR_TOKEN=
