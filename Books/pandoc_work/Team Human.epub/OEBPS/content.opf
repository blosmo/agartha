<dc:title>Team Human</dc:title>
<dc:creator id="creator01">Douglas Rushkoff</dc:creator>
<meta property="role" refines="#creator01" scheme="marc:relators">edt</meta>
<dc:publisher>W. W. Norton &amp; Company</dc:publisher>
